{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "xsim: current file as top",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/../useful/xsim.ps1",
                "-Top",
                "${fileBasenameNoExtension}",
                "-LabDir",
                "${workspaceFolder}"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "xsim: current file as top (GUI)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/../useful/xsim.ps1",
                "-Top",
                "${fileBasenameNoExtension}",
                "-LabDir",
                "${workspaceFolder}",
                "-Gui"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "clear": true
            },
        }
    ]
}